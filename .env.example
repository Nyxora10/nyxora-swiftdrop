# ==============================================================================
# SwiftDrop Monorepo Environment Variables (.env.example)
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Database Configuration (PostgreSQL 15)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# RabbitMQ Configuration (Message Broker)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT Security (HMAC-SHA256, minimum 256 bits / 32 bytes)
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration (Comma-separated allowed origins for API Gateway)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Microservice Port Configuration
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PARCEL_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
AI_SERVICE_PORT=8084

# Gateway Downstream Service Routing URLs
AUTH_SERVICE_URL=http://localhost:8081
PARCEL_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083
AI_SERVICE_URL=http://localhost:8084

# Google OAuth 2.0 (Identity Provider)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Apple Sign In (Identity Provider)
APPLE_CLIENT_ID=your_apple_service_id_or_bundle_id

# Facebook Login (Identity Provider)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
