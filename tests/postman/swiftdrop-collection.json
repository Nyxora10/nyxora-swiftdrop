    {
      "name": "01 Login with seed accounts",
      "description": "Accounts from docker/postgres/seed-data.sql",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@swiftdrop.lk\",\n  \"password\": \"Admin@SwiftDrop2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns a Bearer access token\", function () {",
                  "    pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
                  "});",
                  "pm.test(\"Role is ROLE_ADMIN\", function () { pm.expect(body.role).to.eql(\"ROLE_ADMIN\"); });",
                  "pm.collectionVariables.set(\"adminToken\", body.accessToken);"
                ]
