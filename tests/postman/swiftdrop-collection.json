            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Nimal is in the results\", function () {",
                  "    const emails = pm.response.json().content.map(function (u) { return u.email; });",
                  "    pm.expect(emails).to.include(\"courier.nimal@swiftdrop.lk\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin views Nimal's details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
