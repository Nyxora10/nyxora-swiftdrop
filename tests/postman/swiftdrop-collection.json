                "v1",
                "auth",
                "admin",
                "users",
                "{{nimalUserId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Courier details from the seed\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.email).to.eql(\"courier.nimal@swiftdrop.lk\");",
                  "    pm.expect(body.role).to.eql(\"ROLE_COURIER\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer cannot access admin endpoints",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "admin",
                "users"
